# Copy to .env and fill in. .env is git-ignored — never commit it.

# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_ENV=production            # production | development
DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=api.fidni.fr,localhost,127.0.0.1
SECURE_SSL_REDIRECT=False        # the Cloudflare tunnel already terminates TLS

# ── CORS / CSRF ─────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://fidni.fr
CSRF_TRUSTED_ORIGINS=https://api.fidni.fr,https://fidni.fr

# ── Frontend (used in verification e-mail links) ───────────────────────────
FRONTEND_URL=https://fidni.fr

# ── Google ─────────────────────────────────────────────────────────────────
# « Connexion avec Google » : seul le Client ID (public, le même que dans le front) sert à
# vérifier les jetons d'identité. Le code secret du client OAuth n'est PAS utilisé : ne le
# mets ni ici ni ailleurs. Sans cette ligne, le Client ID par défaut de base.py s'applique.
GOOGLE_CLIENT_ID=344349997591-ns0tpm59m2ugm33783rsrvl60avp9eeb.apps.googleusercontent.com

# ── Email ──────────────────────────────────────────────────────────────────
# Preferred: Brevo's HTTP API. Set BREVO_API_KEY and leave EMAIL_BACKEND unset
# — prod.py then selects config.email_backends.BrevoAPIEmailBackend on its own.
# The API ignores the sender's IP, unlike the SMTP relay below, which answers
# `525 Unauthorized IP address` from any host missing from Brevo's allow-list.
BREVO_API_KEY=
# BREVO_TIMEOUT=10

# Fallback: plain SMTP (Brevo relay / Resend / Mailgun / SES …). Only used
# when BREVO_API_KEY is empty. Remember to allow-list the sending IP.
# Use django.core.mail.backends.console.EmailBackend to print to logs instead.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Fidni <no-reply@fidni.fr>


# ── Database: AWS RDS PostgreSQL ────────────────────────────────────────────
DB_ENGINE=postgresql
DB_HOST=<your-rds-endpoint>.rds.amazonaws.com
DB_PORT=5432
DB_NAME=fidni
DB_USER=fidni
# Either set DB_PASSWORD directly…
#DB_PASSWORD=
# …or let it be fetched from AWS Secrets Manager (needs AWS credentials):
AWS_DB_SECRET_ARN=
AWS_REGION=eu-west-3
DB_SSLMODE=verify-full
DB_SSLROOTCERT=certs/global-bundle.pem

# ── Misc ────────────────────────────────────────────────────────────────────
AWS_STORAGE_ENABLED=true
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-3
GUNICORN_WORKERS=9
