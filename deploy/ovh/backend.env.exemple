# Modèle de /opt/fidni/secrets/backend.env (JAMAIS dans le dépôt : il est public).
# Le plus simple : partir du backend/.env actuel du PC, puis appliquer les changements ci-dessous.
# (installer-serveur.sh le fait tout seul : il copie ton .env et corrige ces lignes.)

# ── À GARDER tel quel depuis le .env actuel ────────────────────────────────────────────────
# DJANGO_ENV, DEBUG=False, SECRET_KEY, ALLOWED_HOSTS, SECURE_SSL_REDIRECT,
# CORS_ALLOWED_ORIGINS, CSRF_TRUSTED_ORIGINS, FRONTEND_URL,
# BREVO_API_KEY, DEFAULT_FROM_EMAIL, clés d'IA (OPENAI_…) s'il y en a.

# ── À CHANGER ──────────────────────────────────────────────────────────────────────────────
DB_PASSWORD=          # généré par installer-serveur.sh (le même que /opt/fidni/secrets/db_password)
GUNICORN_WORKERS=3    # 2 × nombre de cœurs + 1, sans dépasser la mémoire (≈ 150 Mo par worker)

# ── À SUPPRIMER (propres à AWS, inutiles sur OVH) ─────────────────────────────────────────
# DB_HOST, DB_SSLMODE, DB_SSLROOTCERT, AWS_DB_SECRET_ARN, AWS_REGION,
# AWS_STORAGE_ENABLED, AWS_STORAGE_BUCKET_NAME, AWS_S3_REGION_NAME,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# (docker-compose.yml fixe lui-même DB_HOST=db, DB_SSLMODE=disable, AWS_STORAGE_ENABLED=false.)
